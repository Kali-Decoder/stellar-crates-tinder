# Stellar portfolio API (Mongo optional)
# Copy to .env for local `npm run dev`. For production, set these on the API host.
# Full UI + API template: ../swyft/.env.example

MONGODB_URI=mongodb://127.0.0.1:27017/swyft
STELLAR_PORTFOLIO_PORT=8787
# CORS allowlist — must match the deployed UI origin
PUBLIC_ORIGIN=http://localhost:5173

# DEMOUSD faucet (swyft/scripts/faucet-demousd.mjs) — testnet only.
# Shared demo: import CLI keys once (do not commit secrets):
#   stellar keys add demo-admin --secret-key --overwrite          # → GDVJOVC…
#   stellar keys add demo-usdc-issuer --secret-key --overwrite    # → GAK7…
# Default signer is CLI identity demo-usdc-issuer. Optional overrides:
# FAUCET_ISSUER_SECRET=S...
# FAUCET_ISSUER_MNEMONIC="word1 word2 ... word12"
# FAUCET_ISSUER_IDENTITY=demo-usdc-issuer
