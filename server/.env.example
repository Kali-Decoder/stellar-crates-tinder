# Stellar portfolio API (Mongo optional)
# Copy to .env for local `npm run dev`. For production, set these on the API host.
# Full UI + API template: ../swyft/.env.example

MONGODB_URI=mongodb://127.0.0.1:27017/swyft
STELLAR_PORTFOLIO_PORT=8787
# CORS allowlist — must match the deployed UI origin
PUBLIC_ORIGIN=http://localhost:5173
