# Stellar portfolio API (Mongo optional)
# Copy to .env for local `npm run dev`. For production, set these on Render.

MONGODB_URI=mongodb://127.0.0.1:27017/swyft
STELLAR_PORTFOLIO_PORT=8787
# CORS allowlist — must match the deployed UI origin (Vercel URL in prod)
PUBLIC_ORIGIN=http://localhost:5173

# DEMOUSD faucet — Render uses SDK mint (no Stellar CLI).
# Required on Render:
FAUCET_ISSUER_SECRET=
# Optional overrides (defaults: server/deploy.json)
# STELLAR_USDC_CONTRACT=CDLPZ6OAYSNO4LNXKL3GCLG57KTOQRBXWEE775XO3CUC4Y7GOBV2CRAA
# STELLAR_USDC_ISSUER=GAK7PGZIGH2ASZY6LF762ACROPQGBF7X4ZNUMPIMMOEP5ZFTGWTSA4TY
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Local-only CLI fallback (omit FAUCET_ISSUER_SECRET to use stellar CLI):
# FAUCET_ISSUER_IDENTITY=demo-usdc-issuer
