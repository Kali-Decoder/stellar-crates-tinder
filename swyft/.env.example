# =============================================================================
# swyft.fun — environment (copy to `.env` for local; set on your host for deploy)
#   cp .env.example .env
# =============================================================================
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Rebuild after changing any VITE_* value (`npm run build`).
# =============================================================================

# -----------------------------------------------------------------------------
# Client (Vite) — required for production UI deploy
# -----------------------------------------------------------------------------

# Default product surface (Freighter + Stellar mock feed). Keep true for swyft.fun.
VITE_MOCK_UI=true

# Set true only to force the legacy Privy / multi-chain LiveRoot app.
# VITE_LIVE_UI=false

# Stellar network endpoints (testnet defaults match deploy.json)
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Portfolio / faucet API origin for production static hosting.
# Leave empty in local `npm run dev` (Vite proxies /api → API_PROXY_TARGET).
# Example production: https://api.swyft.fun
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Local Vite dev proxy (not baked into the client bundle)
# -----------------------------------------------------------------------------

# Where Vite forwards /api during `npm run dev` / `npm run dev:stack`
API_PROXY_TARGET=http://localhost:8787

# -----------------------------------------------------------------------------
# Stellar portfolio API (../server) — set these on the API host
# Mirror into server/.env when running `npm run dev:stellar-api` / `dev:stack`.
# -----------------------------------------------------------------------------

# MongoDB Atlas or local. Omit / leave blank → in-memory store (lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/swyft

# API listen port (also accepts PORT on some hosts)
STELLAR_PORTFOLIO_PORT=8787

# Browser origin allowed by CORS (your deployed UI URL in production)
PUBLIC_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Production checklist (set on the platform, do not commit secrets)
# -----------------------------------------------------------------------------
# UI host:
#   VITE_MOCK_UI=true
#   VITE_API_BASE_URL=https://<your-api-host>
#   VITE_STELLAR_RPC_URL / VITE_STELLAR_HORIZON_URL / VITE_STELLAR_NETWORK_PASSPHRASE
#   then: npm ci && npm run build  →  dist/client
#
# API host (../server):
#   MONGODB_URI=mongodb+srv://...
#   PUBLIC_ORIGIN=https://<your-ui-host>
#   STELLAR_PORTFOLIO_PORT=8787   # or PORT from the platform
#
# Optional ops (scripts/, not required for UI build):
#   NETWORK=testnet
#   SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
#   ORACLE_ID=<dia-oracle contract id>
#   UPDATER_SECRET=<secret for oracle updater identity>
#   UPDATER_KEY_NAME=demo-admin
#   PRICE_INTERVAL_MS=300000
