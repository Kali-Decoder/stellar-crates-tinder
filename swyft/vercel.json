{
  "buildCommand": "npm run db:migrate && npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler?path=$1" },
    { "source": "/dia-api/(.*)", "destination": "https://api.diadata.org/$1" },
    {
      "source": "/yahoo-api/(.*)",
      "destination": "https://query1.finance.yahoo.com/$1"
    }
  ]
}
