{
  "name": "swyft.fun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "VITE_MOCK_UI=true vite",
    "dev:mock": "VITE_MOCK_UI=true vite",
    "dev:web": "vite",
    "dev:stellar-api": "npm --prefix ../server run dev",
    "dev:stack": "concurrently -k \"npm:dev:stellar-api\" \"npm:dev:mock\"",
    "build": "tsc -b && vite build",
    "lint": "biome lint src tests scripts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "npm run build:contracts && cd contracts && CARGO_TARGET_DIR=./target cargo test --workspace",
    "build:contracts": "cd contracts && CARGO_TARGET_DIR=./target cargo build --release --target wasm32v1-none -p share-token -p bucket-vault -p dia-oracle",
    "oracle:fetch": "node scripts/fetch-oracle-price.mjs",
    "oracle:update": "node scripts/update-oracle-feeds.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.3.0",
    "@fontsource/archivo-black": "^5.2.6",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/instrument-serif": "^5.3.0",
    "@privy-io/react-auth": "3.35.2",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "viem": "2.55.5",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "jayson": {
      "uuid": "8.3.2"
    },
    "rpc-websockets": {
      ".": "9.3.0",
      "uuid": "8.3.2"
    },
    "uuid": "14.0.1",
    "ws": "8.21.1"
  }
}
